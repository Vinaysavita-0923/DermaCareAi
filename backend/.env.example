# Copy this file to .env and adjust for your machine.
# .env is in .gitignore — never commit real values.

# --- Phase 1 (in use now) ---
APP_ENV=development
DEBUG=true

# Comma-separated list of frontend origins allowed to call this API.
# 5173 is Vite's default dev server port (this project uses Vite, not
# Create React App — don't change this to 3000).
# Never set this to * while CORS_ALLOW_CREDENTIALS is true — the app
# will refuse to start if you do (see app/core/config.py).
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
CORS_ALLOW_CREDENTIALS=true

# --- Phase 2 (in use now) ---
# SQLite file for local development. To move to PostgreSQL later,
# change this one value — nothing else in the app needs to change:
#   DATABASE_URL=postgresql+psycopg://user:password@localhost/skincare
DATABASE_URL=sqlite:///./skincare.db

# --- Phase 3 (in use now) ---
# Generate a real value with: python -c "import secrets; print(secrets.token_urlsafe(32))"
# If left unset, the app auto-generates a random one for THIS PROCESS
# ONLY — fine for a quick local test, but every restart invalidates
# every existing token. Set a real value for stable local development.
# In production, the app refuses to start without one (see
# app/core/config.py).
SECRET_KEY=
ACCESS_TOKEN_EXPIRE_MINUTES=43200

# --- Google OAuth (prep only — not implemented yet, see README) ---
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GOOGLE_REDIRECT_URI=http://localhost:5173/auth/google/callback

# --- Chatbot / LLM provider (Phase 5) ---
# Only "mock" is implemented. The mock needs no API key and no network;
# the backend runs and all tests pass without any LLM credentials.
# A real provider will be added later as another value here, with its
# key read from LLM_API_KEY (server-side only — never sent to the
# frontend).
LLM_PROVIDER=mock
LLM_API_KEY=
LLM_TIMEOUT_SECONDS=20
CHAT_HISTORY_LIMIT=20
CHAT_MESSAGE_MAX_CHARS=2000

# --- Acne model (Phase 6) ---
# Path to a VERIFIED trained PyTorch checkpoint. Leave empty until one
# exists: while empty (or the file is missing), /acne/analyze returns
# "model_not_configured" and never fabricates a prediction. A dataset
# is NOT a trained model — do not point this at a dataset.
ACNE_MODEL_PATH=
ACNE_MAX_IMAGE_MB=8

# --- Agent (set LLM_PROVIDER=ollama after installing Ollama) ---
# Install: https://ollama.com/download   then:  ollama pull qwen2.5:3b
# Fully local: chat text never leaves this machine.
# OLLAMA_BASE_URL=http://127.0.0.1:11434
# OLLAMA_MODEL=qwen2.5:3b
# OLLAMA_TIMEOUT_SECONDS=180
# AGENT_MAX_STEPS=4

# --- Cloud agent providers (set LLM_PROVIDER=gemini or groq) ---
# Free-tier cloud APIs. Unlike "ollama", chat text (never face images)
# leaves this machine and is subject to that provider's terms.
#   Gemini key:  https://aistudio.google.com/apikey
#   Groq key:    https://console.groq.com/keys
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-3.8-flash
# GROQ_API_KEY=
# GROQ_MODEL=openai/gpt-oss-120b
# GROQ_FALLBACK_MODELS=openai/gpt-oss-20b,qwen/qwen3.8-27b
# CLOUD_LLM_TIMEOUT_SECONDS=25
#
# Optional: try more providers in order if the primary one fails this
# turn, finishing with the offline mock instead of an error. A listed
# provider with no key set is skipped, not treated as an error. Example,
# with LLM_PROVIDER=gemini:
# LLM_FALLBACK_CHAIN=groq
